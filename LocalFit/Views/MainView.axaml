<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:LocalFit.ViewModels"
			 xmlns:local="using:LocalFit.Views"
			 mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
			 x:Class="LocalFit.Views.MainView"
			 x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>
	<Grid RowDefinitions="*,Auto">
		<ContentControl Content="{Binding CurrentView}">
			<ContentControl.DataTemplates>
				<DataTemplate DataType="vm:OnboardingViewModel">
					<local:OnboardingView />
				</DataTemplate>
				<DataTemplate DataType="vm:FoodManagerViewModel">
					<local:FoodManager />
				</DataTemplate>
				<DataTemplate DataType="vm:DayTrackerViewModel">
					<local:DayTrackerView />
				</DataTemplate>
				<DataTemplate DataType="vm:WeightTrackerViewModel">
					<local:WeightTrackerView />
				</DataTemplate>
				<DataTemplate DataType="vm:SettingsViewModel">
					<local:SettingsView />
				</DataTemplate>
			</ContentControl.DataTemplates>
		</ContentControl>
		<Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Background="#FFFFFF">
			<Grid ColumnDefinitions="*,*,*,*">
			<Button Command="{Binding NavigateToDayTrackerCommand}"
					HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Height="50"
					Background="Transparent">
				<StackPanel Spacing="4">
					<LucideIcon Kind="Calendar" Size="24" HorizontalAlignment="Center" Foreground="#000000"/>
					<TextBlock Text="Day" FontSize="10" HorizontalAlignment="Center" Foreground="#000000"/>
				</StackPanel>
			</Button>
			<Button Command="{Binding NavigateToWeightTrackerCommand}"
					HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Height="50" Grid.Column="1"
					Background="Transparent">
				<StackPanel Spacing="4">
					<LucideIcon Kind="Scale" Size="24" HorizontalAlignment="Center" Foreground="#000000"/>
					<TextBlock Text="Weight" FontSize="10" HorizontalAlignment="Center" Foreground="#000000"/>
				</StackPanel>
			</Button>
			<Button Command="{Binding NavigateToFoodManagerCommand}"
					HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Height="50" Grid.Column="2"
					Background="Transparent">
				<StackPanel Spacing="4">
					<LucideIcon Kind="UtensilsCrossed" Size="24" HorizontalAlignment="Center" Foreground="#000000"/>
					<TextBlock Text="Food" FontSize="10" HorizontalAlignment="Center" Foreground="#000000"/>
				</StackPanel>
			</Button>
			<Button Command="{Binding NavigateToSettingsCommand}"
					HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Height="50" Grid.Column="3"
					Background="Transparent">
				<StackPanel Spacing="4">
					<LucideIcon Kind="Settings" Size="24" HorizontalAlignment="Center" Foreground="#000000"/>
					<TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center" Foreground="#000000"/>
				</StackPanel>
			</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>
