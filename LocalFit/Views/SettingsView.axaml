<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:LocalFit.ViewModels"
			 xmlns:local="using:LocalFit.Views.Dialogs"
			 xmlns:lang="using:LocalFit.Lang"
			 mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
			 x:Class="LocalFit.Views.SettingsView"
			 x:DataType="vm:SettingsViewModel">
	<Design.DataContext>
		<vm:SettingsViewModel/>
	</Design.DataContext>
	<Grid>
		<ScrollViewer>
		<StackPanel Margin="20" Spacing="20">
			<TextBlock Text="{x:Static lang:Resources.Settings_Title}" FontSize="28" FontWeight="Bold"/>
			
			<!-- Fitness Goals Section -->
			<Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,0,0,20">
				<StackPanel Spacing="15">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="{x:Static lang:Resources.Settings_FitnessGoals}" FontSize="20" FontWeight="SemiBold" Grid.Column="0"/>
						<Button Command="{Binding ShowGoalSetupDialogCommand}" Grid.Column="1">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<LucideIcon Kind="Pencil" Size="16"/>
								<TextBlock Text="{x:Static lang:Resources.Settings_Edit}"/>
							</StackPanel>
						</Button>
					</Grid>
					
					<StackPanel Spacing="10" Margin="0,10,0,0">
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Text="{x:Static lang:Resources.Settings_Goal}" Grid.Column="0" Width="120" Opacity="0.7"/>
							<TextBlock Text="{Binding GoalDisplayName}" Grid.Column="1" FontWeight="SemiBold"/>
						</Grid>
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Text="{x:Static lang:Resources.Settings_FitnessLevel}" Grid.Column="0" Width="120" Opacity="0.7"/>
							<TextBlock Text="{Binding FitnessLevelDisplayName}" Grid.Column="1" FontWeight="SemiBold"/>
						</Grid>
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Text="{x:Static lang:Resources.Settings_Sex}" Grid.Column="0" Width="120" Opacity="0.7"/>
							<TextBlock Text="{Binding SexDisplayName}" Grid.Column="1" FontWeight="SemiBold"/>
						</Grid>
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Text="{x:Static lang:Resources.Settings_DietType}" Grid.Column="0" Width="120" Opacity="0.7"/>
							<TextBlock Text="{Binding DietTypeDisplayName}" Grid.Column="1" FontWeight="SemiBold"/>
						</Grid>
					</StackPanel>
					
					<!-- Calculated Nutrition Targets -->
					<Border Background="#DDDDDD" CornerRadius="8" Padding="15" Margin="0,10,0,0">
						<StackPanel Spacing="8">
							<TextBlock Text="{x:Static lang:Resources.Settings_DailyNutritionTargets}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#222222"/>
							<Grid ColumnDefinitions="Auto,*">
								<TextBlock Text="{x:Static lang:Resources.Settings_Calories}" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
								<TextBlock Text="{Binding CalculatedCalories, StringFormat='{}{0:F0}'}" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							</Grid>
							<Grid ColumnDefinitions="Auto,*">
								<TextBlock Text="{x:Static lang:Resources.Settings_Protein}" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
								<TextBlock Text="{Binding CalculatedProtein, StringFormat='{}{0:F1}g'}" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							</Grid>
							<Grid ColumnDefinitions="Auto,*">
								<TextBlock Text="{x:Static lang:Resources.Settings_Fat}" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
								<TextBlock Text="{Binding CalculatedFat, StringFormat='{}{0:F1}g'}" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							</Grid>
							<Grid ColumnDefinitions="Auto,*">
								<TextBlock Text="{x:Static lang:Resources.Settings_Carbs}" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
								<TextBlock Text="{Binding CalculatedCarbs, StringFormat='{}{0:F1}g'}" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>
			
			<!-- Tools Section -->
			<Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,0,0,20">
				<StackPanel Spacing="15">
					<TextBlock Text="{x:Static lang:Resources.Settings_Tools}" FontSize="20" FontWeight="SemiBold"/>
					<Button Command="{Binding ShowNutritionCalculatorCommand}" Margin="0,10,0,0">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<LucideIcon Kind="Calculator" Size="16"/>
							<TextBlock Text="{x:Static lang:Resources.Settings_NutritionCalculator}"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>
			
			<!-- General Settings Section (Placeholder) -->
			<Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,0,0,20">
				<StackPanel Spacing="15">
					<TextBlock Text="{x:Static lang:Resources.Settings_GeneralSettings}" FontSize="20" FontWeight="SemiBold"/>
					<TextBlock Text="{x:Static lang:Resources.Settings_ComingSoon}" FontSize="14" Opacity="0.6" Margin="0,10,0,0"/>
				</StackPanel>
			</Border>
			
			<!-- About Section (Placeholder) -->
			<Border Padding="0,0,0,20">
				<StackPanel Spacing="15">
					<TextBlock Text="{x:Static lang:Resources.Settings_About}" FontSize="20" FontWeight="SemiBold"/>
					<TextBlock Text="LocalFit" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
					<TextBlock Text="{x:Static lang:Resources.Settings_FitnessTrackerApp}" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="{Binding Version}" FontSize="12" Opacity="0.6" Margin="0,5,0,0"/>
				</StackPanel>
			</Border>
		</StackPanel>
		</ScrollViewer>
	
		<!-- Dialog Overlay -->
		<Grid IsVisible="{Binding IsGoalSetupDialogVisible}" ZIndex="100">
		<Rectangle Fill="#80000000" Opacity="0.7"/>
		<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
				CornerRadius="8" 
				BorderBrush="#222222"
				BorderThickness="2"
				Padding="0"
				Width="400"
				MaxHeight="550"
				VerticalAlignment="Center"
				HorizontalAlignment="Center">
			<local:GoalSetupDialog DataContext="{Binding GoalSetupDialogViewModel}"/>
		</Border>
		</Grid>
	</Grid>
</UserControl>
