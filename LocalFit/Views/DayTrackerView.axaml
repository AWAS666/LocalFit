<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:LocalFit.ViewModels"
			 xmlns:local="using:LocalFit.Views.Dialogs"
			 xmlns:lucide="using:Lucide.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
			 x:Class="LocalFit.Views.DayTrackerView"
			 x:DataType="vm:DayTrackerViewModel">
	<Design.DataContext>
		<vm:DayTrackerViewModel/>
	</Design.DataContext>
	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
		<!-- Date Navigation -->
		<Grid ColumnDefinitions="Auto,*,Auto" Margin="10" Grid.Row="0">
			<Button Command="{Binding LastDayCommand}" Grid.Column="0">
				<LucideIcon Kind="ChevronLeft" Size="24"/>
			</Button>
			<TextBlock Text="{Binding Current.Date, StringFormat='{}{0:dddd, MMMM d, yyyy}'}" 
					   FontSize="18" FontWeight="SemiBold" 
					   HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
			<Button Command="{Binding NextDayCommand}" Grid.Column="2">
				<LucideIcon Kind="ChevronRight" Size="24"/>
			</Button>
		</Grid>
		
		<!-- Nutrition Summary Cards -->
		<Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*" Margin="10" ColumnSpacing="10" RowSpacing="10">
			<Border Background="{Binding CaloriesBackgroundColor}" CornerRadius="8" Padding="15" Grid.Row="0" Grid.Column="0">
				<StackPanel>
					<TextBlock Text="Calories (kcal)" FontSize="12" Foreground="{Binding CaloriesForegroundColor}" Opacity="0.9"/>
					<TextBlock Text="{Binding CaloriesDisplay}" FontSize="24" FontWeight="Bold" Foreground="{Binding CaloriesForegroundColor}"/>
				</StackPanel>
			</Border>
			
			<Border Background="{Binding ProteinBackgroundColor}" CornerRadius="8" Padding="15" Grid.Row="0" Grid.Column="1">
				<StackPanel>
					<TextBlock Text="Protein (g)" FontSize="12" Foreground="#FFFFFF" Opacity="0.9"/>
					<TextBlock Text="{Binding ProteinDisplay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
				</StackPanel>
			</Border>
			
			<Border Background="{Binding FatBackgroundColor}" CornerRadius="8" Padding="15" Grid.Row="1" Grid.Column="0">
				<StackPanel>
					<TextBlock Text="Fat (g)" FontSize="12" Foreground="#FFFFFF" Opacity="0.9"/>
					<TextBlock Text="{Binding FatDisplay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
				</StackPanel>
			</Border>
			
			<Border Background="{Binding CarbsBackgroundColor}" CornerRadius="8" Padding="15" Grid.Row="1" Grid.Column="1">
				<StackPanel>
					<TextBlock Text="Carbs (g)" FontSize="12" Foreground="#FFFFFF" Opacity="0.9"/>
					<TextBlock Text="{Binding CarbsDisplay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
				</StackPanel>
			</Border>
		</Grid>
		
		<!-- Foods Eaten List -->
		<ListBox ItemsSource="{Binding Eaten}" Grid.Row="2" Margin="10" Background="Transparent">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid ColumnDefinitions="*,Auto,Auto">
						<StackPanel Margin="10">
							<TextBlock Text="{Binding Preset.Name}" FontWeight="SemiBold" FontSize="16"/>
							<TextBlock FontSize="12" Margin="0,4,0,0">
								<Run Text="{Binding AmountDisplay}"/>
								<Run Text=" | "/>
								<Run Text="{Binding Calories, StringFormat='{}{0:F0} kcal'}"/>
							</TextBlock>
						</StackPanel>
						<Button Command="{Binding $parent[UserControl].DataContext.ShowEditEatenFoodDialogCommand}" 
								CommandParameter="{Binding}" 
								Grid.Column="1" 
								Margin="5,10"
								Background="Transparent">
							<LucideIcon Kind="Pencil" Size="20" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
						</Button>
						<Button Command="{Binding $parent[UserControl].DataContext.RemoveFoodCommand}" 
								CommandParameter="{Binding}" 
								Grid.Column="2" 
								Margin="5,10"
								Background="Transparent">
							<LucideIcon Kind="Trash2" Size="20" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		
		<!-- Add Food Button -->
		<Button Command="{Binding ShowAddFoodDialogCommand}" 
				Margin="10" 
				Height="56" 
				Width="56"
				Grid.Row="4"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				CornerRadius="28"
				Background="#222222">
			<LucideIcon Kind="Plus" Size="28" Foreground="#DDDDDD"/>
		</Button>
		
		<!-- Dialog Overlays -->
		<Grid ZIndex="100" Grid.Row="0" Grid.RowSpan="5">
			<!-- Add Food Dialog -->
			<Grid IsVisible="{Binding IsAddFoodDialogVisible}">
				<Rectangle Fill="#80000000" Opacity="0.7" Tapped="OnBackdropTapped"/>
				<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
						CornerRadius="8" 
						BorderBrush="#222222"
						BorderThickness="2"
						Padding="0"
						Width="400"
						MaxHeight="600"
						VerticalAlignment="Center"
						HorizontalAlignment="Center">
					<local:AddFoodDialog DataContext="{Binding AddFoodDialogViewModel}"/>
				</Border>
			</Grid>
			
			<!-- Edit Eaten Food Dialog -->
			<Grid IsVisible="{Binding IsEditEatenFoodDialogVisible}">
				<Rectangle Fill="#80000000" Opacity="0.7" Tapped="OnBackdropTapped"/>
				<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
						CornerRadius="8" 
						BorderBrush="#222222"
						BorderThickness="2"
						Padding="0"
						Width="400"
						MaxHeight="350"
						VerticalAlignment="Center"
						HorizontalAlignment="Center">
					<local:EditEatenFoodDialog DataContext="{Binding EditEatenFoodDialogViewModel}"/>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
