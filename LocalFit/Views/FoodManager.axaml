<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:LocalFit.ViewModels"
			 xmlns:local="using:LocalFit.Views.Dialogs"
			 mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
			 x:Class="LocalFit.Views.FoodManager"
			 x:DataType="vm:FoodManagerViewModel">
	<Design.DataContext>
		<vm:FoodManagerViewModel/>
	</Design.DataContext>
	<Grid RowDefinitions="Auto,Auto,*,Auto">
		<!-- Header -->
		<TextBlock Text="Food Manager" FontSize="24" FontWeight="Bold" Margin="20,20,20,10" Grid.Row="0"/>
		
		<!-- Search -->
		<TextBox Text="{Binding SearchText}" VerticalContentAlignment="Center" Watermark="Search foods..." Grid.Row="1" Margin="20,0" Height="44"/>
		
		<!-- Food List -->
		<ListBox ItemsSource="{Binding Foods}" Grid.Row="2" Margin="10" Background="Transparent">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="15">
						<Grid ColumnDefinitions="*,Auto,Auto">
							<StackPanel Grid.Column="0">
								<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
								<TextBlock FontSize="12" Margin="0,4,0,0" Opacity="0.7">
									<Run Text="Cal: "/>
									<Run Text="{Binding Calories}"/>
									<Run Text=" kcal"/>
									<Run Text="{Binding UnitDisplay}"/>
									<Run Text=" | P: "/>
									<Run Text="{Binding Protein}"/>
									<Run Text="g"/>
									<Run Text="{Binding UnitDisplay}"/>
									<Run Text=" | F: "/>
									<Run Text="{Binding Fat}"/>
									<Run Text="g"/>
									<Run Text="{Binding UnitDisplay}"/>
									<Run Text=" | C: "/>
									<Run Text="{Binding Carbs}"/>
									<Run Text="g"/>
									<Run Text="{Binding UnitDisplay}"/>
								</TextBlock>
							</StackPanel>
							<Button Command="{Binding $parent[UserControl].DataContext.ShowEditFoodDialogCommand}" 
									CommandParameter="{Binding}" 
									Grid.Column="1" 
									Margin="10,0"
									Background="Transparent">
								<LucideIcon Kind="Pencil" Size="20" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
							</Button>
							<Button Command="{Binding $parent[UserControl].DataContext.RemoveCommand}" 
									CommandParameter="{Binding}" 
									Grid.Column="2" 
									Margin="10,0"
									Background="Transparent">
								<LucideIcon Kind="Trash2" Size="20" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
							</Button>
						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		
		<!-- Pagination and Add Button -->
		<Grid ColumnDefinitions="*,Auto,*" Margin="20,10" Grid.Row="3">
			<!-- Pagination -->
			<Grid ColumnDefinitions="Auto,Auto,Auto" Grid.Column="1" HorizontalAlignment="Center">
				<Button Command="{Binding PreviousPageCommand}" Grid.Column="0" Width="44" Height="44" Background="Transparent">
					<LucideIcon Kind="ChevronLeft" Size="24"/>
				</Button>
				<TextBlock Text="{Binding Page}" VerticalAlignment="Center" Grid.Column="1" Margin="15,0" FontSize="16" FontWeight="SemiBold"/>
				<Button Command="{Binding NextPageCommand}" Grid.Column="2" Width="44" Height="44" Background="Transparent">
					<LucideIcon Kind="ChevronRight" Size="24"/>
				</Button>
			</Grid>
			
			<!-- Add Food Button -->
			<Button Command="{Binding ShowAddFoodDialogCommand}" 
					Grid.Column="2"
					Height="56" 
					Width="56"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					CornerRadius="28"
					Background="#222222">
				<LucideIcon Kind="Plus" Size="28" Foreground="#DDDDDD"/>
			</Button>
		</Grid>
		
		<!-- Dialog Overlay -->
		<Grid IsVisible="{Binding IsEditFoodDialogVisible}" ZIndex="100" Grid.Row="0" Grid.RowSpan="4">
			<Rectangle Fill="#80000000" Opacity="0.7"/>
			<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
					CornerRadius="8" 
					BorderBrush="#222222"
					BorderThickness="2"
					Padding="0"
					Width="400"
					MaxHeight="600"
					VerticalAlignment="Center"
					HorizontalAlignment="Center">
				<local:EditFoodDialog DataContext="{Binding EditFoodDialogViewModel}"/>
			</Border>
		</Grid>
	</Grid>
</UserControl>

