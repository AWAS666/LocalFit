<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:LocalFit.ViewModels"
			 xmlns:lucide="using:Lucide.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
			 x:Class="LocalFit.Views.Dialogs.EditEatenFoodDialog"
			 x:DataType="vm:EditEatenFoodDialogViewModel">
	<StackPanel Margin="20" Spacing="20">
		<TextBlock Text="Edit Food Amount" FontSize="24" FontWeight="Bold"/>

		<StackPanel Spacing="5">
			<TextBlock Text="Food:" FontSize="14" Opacity="0.8"/>
			<TextBlock Text="{Binding FoodName}" FontSize="18" FontWeight="SemiBold"/>
		</StackPanel>

		<StackPanel Spacing="5">
			<TextBlock Text="Amount:"/>
			<NumericUpDown Value="{Binding Amount, Converter={StaticResource NumericUpDownConverter}, ConverterParameter=0}" Minimum="0" Maximum="10000" Increment="1" ShowButtonSpinner="True"/>
			<TextBlock Text="{Binding UnitDisplay}" FontSize="12" Opacity="0.7" Margin="0,5,0,0"/>
		</StackPanel>

		<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10">
			<Button Command="{Binding CancelCommand}" Grid.Column="0" MinWidth="100" Height="44" Width="56">
				<LucideIcon Kind="X" Size="24"/>
			</Button>
			<Button Command="{Binding SaveCommand}" Grid.Column="1" Classes="SaveButton" MinWidth="100" Height="44" Width="56" HorizontalAlignment="Right">
				<LucideIcon Kind="Check" Size="24"/>
			</Button>
		</Grid>
	</StackPanel>
</UserControl>
