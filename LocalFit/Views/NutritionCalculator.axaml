<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:LocalFit.ViewModels"
			 xmlns:lucide="using:Lucide.Avalonia"
			 xmlns:lang="using:LocalFit.Lang"
			 mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
			 x:Class="LocalFit.Views.NutritionCalculator"
			 x:DataType="vm:BMRViewModel">
	<Design.DataContext>
		<vm:BMRViewModel/>
	</Design.DataContext>
	<Grid RowDefinitions="Auto,*,Auto">
		<!-- Header -->
		<Grid ColumnDefinitions="Auto,*,Auto" Margin="10" Grid.Row="0">
			<Button Command="{Binding NavigateBackCommand}" Grid.Column="0">
				<LucideIcon Kind="ArrowLeft" Size="24"/>
			</Button>
			<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Title}" FontSize="24" FontWeight="Bold" 
					   HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
		</Grid>
		
		<!-- Calculator Content -->
		<ScrollViewer Grid.Row="1">
			<StackPanel Margin="20" Spacing="20">
				<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Description}" FontSize="16" Opacity="0.7" Margin="0,0,0,10"/>
				
				<!-- Input Fields -->
				<Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,0,0,20">
					<StackPanel Spacing="10">
						<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_PersonalInformation}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
						
						<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
							<StackPanel Spacing="5" Grid.Column="0">
								<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Weight}"/>
								<NumericUpDown Minimum="0" Maximum="500" Value="{Binding Weight}" Height="44"/>
							</StackPanel>
							
							<StackPanel Spacing="5" Grid.Column="1">
								<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Height}"/>
								<NumericUpDown Minimum="60" Maximum="250" Value="{Binding Height}" Height="44"/>
							</StackPanel>
						</Grid>
						
						<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
							<StackPanel Spacing="5" Grid.Column="0">
								<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Age}"/>
								<NumericUpDown Minimum="0" Maximum="120" Value="{Binding Age}" Height="44"/>
							</StackPanel>
							
							<StackPanel Spacing="5" Grid.Column="1">
								<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Sex}"/>
								<ComboBox SelectedItem="{Binding SelectedSexItem}" ItemsSource="{Binding Sexes}"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>
				
				<Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,0,0,20">
					<StackPanel Spacing="10">
						<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_ActivityGoals}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
						
						<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
							<StackPanel Spacing="5" Grid.Column="0">
								<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_FitnessLevel}"/>
								<ComboBox SelectedItem="{Binding SelectedFitnessItem}" ItemsSource="{Binding FitnessLevels}"/>
							</StackPanel>
							
							<StackPanel Spacing="5" Grid.Column="1">
								<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_CalorieGoal}"/>
								<ComboBox SelectedItem="{Binding SelectedGoalItem}" ItemsSource="{Binding Goals}"/>
							</StackPanel>
						</Grid>
						
						<StackPanel Spacing="5">
							<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_DietType}"/>
							<ComboBox SelectedItem="{Binding SelectedDietTypeItem}" ItemsSource="{Binding DietTypes}"/>
						</StackPanel>
					</StackPanel>
				</Border>
				
				<!-- Results -->
				<Border Background="#DDDDDD" CornerRadius="8" Padding="15">
					<StackPanel Spacing="8">
						<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_DailyNutritionTargets}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#222222"/>
						
						<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="15" RowSpacing="8">
							<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Calories}" Grid.Row="0" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
							<TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" FontSize="16" Foreground="#222222">
								<Run Text="{Binding Calories, StringFormat='{}{0:F0} '}"/>
								<Run Text="{x:Static lang:Resources.NutritionCalculator_Kcal}"/>
							</TextBlock>
							
							<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Protein}" Grid.Row="1" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
							<TextBlock Text="{Binding Protein, StringFormat='{}{0:F1}g'}" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							
							<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Fat}" Grid.Row="2" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
							<TextBlock Text="{Binding Fat, StringFormat='{}{0:F1}g'}" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							
							<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_Carbs}" Grid.Row="3" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
							<TextBlock Text="{Binding Carbs, StringFormat='{}{0:F1}g'}" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
							
							<TextBlock Text="{x:Static lang:Resources.NutritionCalculator_BMI}" Grid.Row="4" Grid.Column="0" Width="100" Opacity="0.7" Foreground="#222222"/>
							<TextBlock Text="{Binding Bmi, StringFormat='{}{0:F1}'}" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Foreground="#222222"/>
						</Grid>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
