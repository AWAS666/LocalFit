<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalFit.ViewModels"
             xmlns:local="using:LocalFit.Views.Dialogs"
             xmlns:lucide="using:Lucide.Avalonia"
             xmlns:lang="using:LocalFit.Lang"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
             x:Class="LocalFit.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">
    <Design.DataContext>
        <vm:OnboardingViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <!-- Step 1: Weight -->
            <Border IsVisible="{Binding NeedsWeight}"
                    Background="#DDDDDD"
                    CornerRadius="12"
                    Padding="30"
                    BorderBrush="#222222"
                    BorderThickness="2"
                    Margin="20"
                    MaxWidth="500"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <lucide:LucideIcon Kind="Scale" Size="64" Foreground="#222222" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Static lang:Resources.Onboarding_Welcome}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#222222"/>
                        <TextBlock Text="{x:Static lang:Resources.Onboarding_GetStarted}" FontSize="16" Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="#222222"/>
                    </StackPanel>
                    
                    <TextBlock Text="{x:Static lang:Resources.Onboarding_Step1_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0" Foreground="#222222"/>
                    <TextBlock Text="{x:Static lang:Resources.Onboarding_Step1_Description}" FontSize="14" Opacity="0.8" TextWrapping="Wrap" Foreground="#222222"/>
                    
                    <Button Command="{Binding ShowWeightDialogCommand}" 
                            Height="50"
                            Margin="0,10"
                            Background="#222222"
                            Foreground="#DDDDDD">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="Background" Value="#111111"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <lucide:LucideIcon Kind="Plus" Size="20" Foreground="#DDDDDD"/>
                            <TextBlock Text="{x:Static lang:Resources.Onboarding_AddWeightEntry}" FontSize="16" Foreground="#DDDDDD"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding SkipWeightCommand}" 
                            Background="Transparent"
                            Height="44"
                            Margin="0,5">
                        <TextBlock Text="{x:Static lang:Resources.Onboarding_SkipForNow}" FontSize="14" Opacity="0.9" Foreground="#222222"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Step 2: Goal -->
            <Border IsVisible="{Binding ShowGoalStep}"
                    Background="#DDDDDD"
                    CornerRadius="12"
                    Padding="30"
                    BorderBrush="#222222"
                    BorderThickness="2"
                    Margin="20"
                    MaxWidth="500"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <lucide:LucideIcon Kind="Award" Size="64" Foreground="#222222" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Static lang:Resources.Onboarding_SetFitnessGoals}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#222222"/>
                    </StackPanel>
                    
                    <TextBlock Text="{x:Static lang:Resources.Onboarding_Step2_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0" Foreground="#222222"/>
                    <TextBlock Text="{x:Static lang:Resources.Onboarding_Step2_Description}" FontSize="14" Opacity="0.8" TextWrapping="Wrap" Foreground="#222222"/>
                    
                    <Button Command="{Binding ShowGoalDialogCommand}" 
                            Height="50"
                            Margin="0,10"
                            Background="#222222"
                            Foreground="#DDDDDD">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="Background" Value="#111111"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <lucide:LucideIcon Kind="Settings" Size="20" Foreground="#DDDDDD"/>
                            <TextBlock Text="{x:Static lang:Resources.Onboarding_SetUpGoals}" FontSize="16" Foreground="#DDDDDD"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding SkipGoalCommand}" 
                            Background="Transparent"
                            Height="44"
                            Margin="0,5">
                        <TextBlock Text="{x:Static lang:Resources.Onboarding_SkipForNow}" FontSize="14" Opacity="0.9" Foreground="#222222"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Step 3: Complete -->
            <Border IsVisible="{Binding IsComplete}"
                    Background="#DDDDDD"
                    CornerRadius="12"
                    Padding="30"
                    BorderBrush="#222222"
                    BorderThickness="2"
                    Margin="20"
                    MaxWidth="500"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <lucide:LucideIcon Kind="Check" Size="64" Foreground="#222222" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static lang:Resources.Onboarding_AllSet}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#222222"/>
                    <TextBlock Text="{x:Static lang:Resources.Onboarding_AllSetDescription}" FontSize="14" Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="#222222"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Dialog Overlays -->
        <Grid Grid.Row="0" Grid.RowSpan="2">
            <!-- Weight Dialog -->
            <Grid IsVisible="{Binding IsWeightDialogVisible}" ZIndex="100">
                <Rectangle Fill="#80000000" Opacity="0.7"/>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="8" 
                        BorderBrush="#222222"
                        BorderThickness="2"
                        Padding="0"
                        Width="400"
                        MaxHeight="550"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <local:AddWeightDialog DataContext="{Binding AddWeightDialogViewModel}"/>
                </Border>
            </Grid>
            
            <!-- Goal Dialog -->
            <Grid IsVisible="{Binding IsGoalDialogVisible}" ZIndex="100">
                <Rectangle Fill="#80000000" Opacity="0.7"/>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="8" 
                        BorderBrush="#222222"
                        BorderThickness="2"
                        Padding="0"
                        Width="400"
                        MaxHeight="550"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <local:GoalSetupDialog DataContext="{Binding GoalSetupDialogViewModel}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
