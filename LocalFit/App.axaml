<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="LocalFit.App"
			 RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.Resources>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<Style Selector="Button.SaveButton">
			<Setter Property="Background" Value="#222222"/>
			<Setter Property="Foreground" Value="#DDDDDD"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="Button.SaveButton:pointerover">
			<Setter Property="Background" Value="#1A1A1A"/>
		</Style>
		<Style Selector="Button.SaveButton:pressed">
			<Setter Property="Background" Value="#111111"/>
		</Style>
		<Style Selector="NumericUpDown">
			<Setter Property="ShowButtonSpinner" Value="False"/>
		</Style>
		<Style Selector="NumericUpDown RepeatButton">
			<Setter Property="Width" Value="48"/>
		</Style>
		<Style Selector="NumericUpDown TextBox">
			<Setter Property="(TextInputOptions.ContentType)" Value="Number"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="MinHeight" Value="44"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="MinHeight" Value="44"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="#DDDDDD"/>
			<Setter Property="Foreground" Value="#222222"/>
		</Style>
		<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#666666"/>
		</Style>
		<Style Selector="ListBoxItem:selected">
			<Setter Property="Background" Value="#DDDDDD"/>
			<Setter Property="Foreground" Value="#222222"/>
		</Style>
		<Style Selector="ListBoxItem:selected:pointerover">
			<Setter Property="Background" Value="#666666"/>
		</Style>
		<Style Selector="ListBoxItem Button">
			<Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/>
		</Style>
		<Style Selector="ListBoxItem Button:pointerover">
			<Setter Property="Background" Value="#DDDDDD"/>
			<Setter Property="Foreground" Value="#222222"/>
		</Style>
		<Style Selector="ListBoxItem Button:pressed">
			<Setter Property="Background" Value="#CCCCCC"/>
			<Setter Property="Foreground" Value="#222222"/>
		</Style>
	</Application.Styles>
</Application>